# Build stage
FROM golang:1.26 AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -o /out/registration-server ./cmd/registration-server

# Run stage
FROM alpine:latest

COPY --from=build /out/registration-server /registration-server

EXPOSE 8080

ENTRYPOINT ["/registration-server"]